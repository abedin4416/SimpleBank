<form id="form" method="POST">
    <div id="form-title"><%- title %></div>
    <input type="<%= type[0] %>" name="<%= name[0] %>" class="form-input first" placeholder="<%= placeholder[0] %>" data-ph="<%= placeholder[0] %>" autocomplete="<%= autocomplete[0] %>"/>
    <input type="<%= type[1] %>" name="<%= name[1] %>" class="form-input second" placeholder="<%= placeholder[1] %>" data-ph="<%= placeholder[1] %>" autocomplete="<%= autocomplete[1] %>"/>
    <button type="submit" id="submit"><%= submit %></button>
</form>